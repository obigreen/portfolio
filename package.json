{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "packageManager": "yarn@1.22.21",
  "workspaces": [
    "web",
    "api"
  ],
  "resolutions": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7"
  },
  "scripts": {
    "dev": "yarn workspace @portfolio/web dev",
    "dev:web": "yarn workspace @portfolio/web dev",
    "dev:api": "yarn workspace @portfolio/api dev",
    "build": "yarn workspace @portfolio/web build",
    "build:github": "yarn workspace @portfolio/web build:github",
    "lint": "yarn workspace @portfolio/web lint",
    "preview": "yarn workspace @portfolio/web preview",
    "test": "yarn workspace @portfolio/web test",
    "deploy:github": "yarn build:github && gh-pages -d web/dist"
  },
  "devDependencies": {
    "gh-pages": "6.3.0"
  }
}
